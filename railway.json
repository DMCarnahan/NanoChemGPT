{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn app:app --bind 0.0.0.0:$PORT --workers 1 --threads 8 --timeout 120 --access-logfile - --error-logfile - --log-level info",
    "healthcheckPath" : "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure"
  }
}
