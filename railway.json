{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand":"python retriever/index_jsonl.py --bundle $BUNDLE_PATH --index_dir $INDEX_DIR && gunicorn -w 2 -b 0.0.0.0:$PORT app:app",
    "healthcheckPath" : "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure"
  }
}
