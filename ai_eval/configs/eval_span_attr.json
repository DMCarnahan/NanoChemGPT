{
  "task": "entity_extraction",
  "dataset": {
    "gold_path": "datasets/gold_span.jsonl"
  },
  "predictions": {
    "pred_path": "datasets/preds_span.jsonl"
  },
  "labels": [
    "ACTION",
    "AMOUNT",
    "ATMOS",
    "CONC",
    "EQUIPMENT",
    "MATERIAL",
    "SPEED",
    "TEMP",
    "TIME",
    "UNIT"
  ],
  "matching": {
    "mode": "iou",
    "iou_threshold": 0.5,
    "casefold": true,
    "strip_punct": false
  },
  "attribute_rules": [
    {
      "type": "cooccurrence",
      "head_label": "AMOUNT",
      "neighbor_label": "UNIT",
      "window": {
        "tokens": 3
      }
    },
    {
      "type": "typed_unit",
      "label": "TEMP",
      "units": [
        "°C",
        "K"
      ],
      "mode": "suffix"
    },
    {
      "type": "typed_unit",
      "label": "SPEED",
      "units": [
        "rpm"
      ],
      "mode": "any"
    },
    {
      "type": "regex",
      "label": "CONC",
      "pattern": "(?:\\d+(?:\\.\\d+)?\\s*(?:M|mol/L|wt%|vol%))"
    },
    {
      "type": "numeric_range",
      "label": "TEMP",
      "range": {
        "min": -273,
        "max": 1500
      }
    },
    {
      "type": "numeric_range",
      "label": "TIME",
      "range": {
        "min": 0,
        "max": 10000000.0
      }
    },
    {
      "type": "numeric_range",
      "label": "SPEED",
      "range": {
        "min": 10,
        "max": 10000
      }
    }
  ],
  "report": {
    "out_path": "reports/report_span_attr.json",
    "errors_path": "reports/errors_span_attr.jsonl"
  }
}