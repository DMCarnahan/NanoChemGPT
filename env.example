# Copy to .env and customize for local/dev
# Server
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_MB=50
MAX_QUESTION_CHARS=6000
MAX_CONTEXT_CHARS=30000
ASK_RATE_LIMIT_PER_MINUTE=20

# Auth
ADMIN_TOKEN=replace-with-a-strong-token

# Answer generation (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=10000
OPENAI_CITATION_MODEL=gpt-6-luna
OPENAI_CITATION_REASONING_EFFORT=none
OPENAI_CITATION_MAX_OUTPUT_TOKENS=4000
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# Retrieval & embeddings. Literature retrieval uses the local hybrid TF-IDF
# indexes; these settings apply to FAISS and global upload stores.
EMBED_BACKEND=st
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMB=text-embedding-3-small
UPLOADS_VECTOR_BACKEND=auto

# NER model path
SPACY_MODEL=harvester/miner/ner_model/model-best

# Enhanced citation filtering
ENABLE_ENHANCED_CITATIONS=true
CITATION_MIN_SCORE=0.25

# Optional services
# GROBID_URL=http://localhost:8070
# EPMC_BASE=https://www.ebi.ac.uk/europepmc/webservices/rest
